{
  // StudBloxd - Cloudflare Worker + Durable Objects (real multiplayer servers)
  "name": "studbloxd",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "WORLD", "class_name": "World" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby", "World"] }]
}
